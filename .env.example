NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional but recommended on Vercel (Google Books shared quota is often exhausted)
GOOGLE_BOOKS_API_KEY=

# Required for movie/TV search. Server-side only: never expose to the browser.
# TMDB v3 api_key (32 hex chars) or v4 read access token (JWT).
TMDB_API_KEY=
